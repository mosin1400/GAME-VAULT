# ---------- Core ----------
NODE_ENV=development
APP_URL=http://localhost:3000
ADMIN_PASSWORD=replace-with-a-12-character-password
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/flowforge
REDIS_URL=redis://127.0.0.1:6379
ENCRYPTION_KEY=change-me-please-32-chars-minimum!!
FILES_DIR=/files
EXECUTIONS_MODE=regular          # regular | queue
WORKER_COUNT=2
MULTI_MAIN=false
ALLOW_SHELL_NODES=true           # اجرای Bash/Python
NODE_FUNCTION_ALLOW_EXTERNAL=lodash,dayjs,axios
NODES_EXCLUDE=                   # مثال: bash,pythonCode (Node-level permissions)

# ---------- AI ----------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_URL=http://localhost:11434
CODEX_ACCESS_TOKEN=              # از ~/.codex/auth.json پس از `codex login --device-code`
CODEX_BASE_URL=https://chatgpt.com/backend-api/codex
CODEX_MODEL=gpt-5-codex
CODEX_ACCOUNT_ID=

# ---------- Messengers ----------
TELEGRAM_BOT_TOKEN=
BALE_BOT_TOKEN=

# ---------- Enterprise ----------
SSO_ISSUER=
SSO_CLIENT_ID=
SSO_CLIENT_SECRET=
LDAP_URL=
LDAP_BIND_DN=
VAULT_ADDR=
VAULT_TOKEN=
LOG_STREAM_URL=
