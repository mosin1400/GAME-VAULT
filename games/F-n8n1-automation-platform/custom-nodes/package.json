{
  "name": "@flowforge/custom-nodes",
  "version": "1.0.0",
  "description": "FlowForge / n8n-compatible custom nodes: Bale, Soroush, TCP/UDP, Codex Agent, File Watcher, Bash, WebSocket, MQTT, Modbus, DB Trigger (CDC)",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": ["n8n-community-node-package", "flowforge", "bale", "soroush", "mqtt", "modbus", "codex"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": ["dist/credentials/BaleApi.credentials.js", "dist/credentials/SoroushApi.credentials.js", "dist/credentials/CodexAuth.credentials.js"],
    "nodes": [
      "dist/nodes/Bale.node.js", "dist/nodes/Soroush.node.js", "dist/nodes/LocalSocket.node.js", "dist/nodes/CodexAgent.node.js",
      "dist/nodes/FileWatcher.node.js", "dist/nodes/BashExecutor.node.js", "dist/nodes/WebSocketNode.node.js", "dist/nodes/MqttClient.node.js",
      "dist/nodes/Modbus.node.js", "dist/nodes/DatabaseTrigger.node.js"
    ]
  },
  "files": ["dist"],
  "dependencies": {
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "typescript": "^5.5.0"
  }
}
