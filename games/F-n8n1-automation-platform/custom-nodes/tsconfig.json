{
  "compilerOptions": {
    "target": "ES2022", "module": "commonjs", "moduleResolution": "node", "lib": ["ES2022", "DOM"],
    "outDir": "dist", "rootDir": "src", "declaration": true, "strict": true, "esModuleInterop": true,
    "skipLibCheck": true, "types": ["node"], "typeRoots": ["../node_modules/@types", "node_modules/@types"]
  },
  "include": ["src/**/*.ts"]
}
