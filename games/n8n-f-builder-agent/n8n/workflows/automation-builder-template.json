      "type": "@chrishdx/n8n-nodes-codex-cli-lm.codexCliLm",
      "typeVersion": 1,
      "position": [
        440,
        480
      ],
      "parameters": {
        "model": "gpt-5-codex"
      },
      "notes": "احراز هویت: codex login داخل کانتینر"
    },
    {
      "id": "730eb43f-2b11-4369-8b98-bcf9adb22bbd",
      "name": "Workflow Builder Tool",
      "type": "n8n-nodes-bale.workflowBuilder",
      "typeVersion": 1,
      "position": [
        640,
        480
      ],
      "parameters": {
        "operation": "create",
        "activate": true,
        "workflowJson": "={{ $fromAI('workflowJson', 'Complete n8n workflow JSON as a string', 'string') }}",
        "publicUrl": "={{ $env.N8N_EDITOR_BASE_URL || '' }}"
      },
      "credentials": {
        "n8nBuilderApi": {
          "name": "n8n Builder API"
        }
      },
      "notes": "لایهٔ ۳ — اعتبارسنجی + POST /api/v1/workflows + activate"
    },
    {
      "id": "70cc49d7-a7bc-455c-bed5-4263bb1eb342",
      "name": "Extract Workflow JSON",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        800,
        260
      ],
      "parameters": {
        "jsCode": "// خروجی Agent را می‌گیریم؛ اگر Agent خودش ابزار را صدا زده باشد، فقط گزارش می‌دهیم.\n// اگر Agent فقط JSON برگردانده باشد (بدون ابزار)، آن را استخراج می‌کنیم تا با HTTP Request ساخته شود.\nconst out = String($json.output ?? '');\nlet wf = null;\ntry { wf = JSON.parse(out); } catch {\n  const m = out.match(/```(?:json)?\\s*([\\s\\S]*?)```/i);\n  if (m) { try { wf = JSON.parse(m[1]); } catch {} }\n  if (!wf) { const a = out.indexOf('{'), b = out.lastIndexOf('}'); if (a !== -1 && b > a) { try { wf = JSON.parse(out.slice(a, b + 1)); } catch {} } }\n}\nconst needsCreate = !!(wf && Array.isArray(wf.nodes));\nreturn [{ json: { needsCreate, workflow: needsCreate ? { name: wf.name || 'Generated Automation', nodes: wf.nodes, connections: wf.connections || {}, settings: { executionOrder: 'v1' }, staticData: null } : null, report: out, prompt: $('Normalize Input').item.json.prompt, chatId: $('Normalize Input').item.json.chatId } }];"
      }
    },
    {
      "id": "fed2a6e3-b8a7-47d3-8dc8-afa00ea0cc62",
