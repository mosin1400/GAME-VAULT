      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        1040,
        260
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "201ca818-33dc-449a-aaed-47d263e75184",
              "leftValue": "={{ $json.needsCreate }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
