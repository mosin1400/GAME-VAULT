# ---------- عمومی ----------
TZ=Asia/Tehran
N8N_VERSION=latest
N8N_PORT=5678
AGENT_PORT=3000

# آدرس‌های عمومی (پشت reverse proxy / دامنه)
N8N_HOST=n8n.example.com
N8N_PROTOCOL=https
N8N_WEBHOOK_URL=https://n8n.example.com/
AGENT_PUBLIC_URL=https://agent.example.com

# ---------- پایگاه داده ----------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=n8n

# ---------- امنیت n8n ----------
N8N_ENCRYPTION_KEY=please-generate-a-long-random-string

# ---------- n8n API / MCP (بعد از اولین اجرا از Settings بگیرید) ----------
N8N_API_KEY=
N8N_MCP_TOKEN=

# ---------- Codex ----------
CODEX_MODE=auto              # auto | codex-cli | codex-n8n | openai-compatible | heuristic
CODEX_MODEL=gpt-5-codex
N8N_CODEX_WEBHOOK_URL=http://n8n:5678/webhook/codex-llm
OPENAI_API_KEY=
OPENAI_BASE_URL=

# ---------- بله / سروش ----------
BALE_BOT_TOKEN=
BALE_WEBHOOK_SECRET=
BALE_DEFAULT_CHAT_ID=
SOROUSH_BOT_TOKEN=

# ---------- Agent ----------
AGENT_SHARED_SECRET=change-me
MAX_HEAL_ATTEMPTS=3
