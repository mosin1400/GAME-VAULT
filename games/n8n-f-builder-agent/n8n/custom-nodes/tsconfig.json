{
  "compilerOptions": {
    "strict": true,
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "es2020",
    "lib": ["es2020"],
    "declaration": true,
    "sourceMap": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": "./dist/",
    "rootDir": "."
  },
  "include": ["credentials/**/*", "nodes/**/*", "index.ts"],
  "exclude": ["dist", "node_modules", "test"]
}
